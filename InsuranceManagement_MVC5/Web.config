<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="AppDbContext"
         connectionString="Data Source=.;Initial Catalog=LegacyBusinessApp;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8"/>
  </system.web>
</configuration>
