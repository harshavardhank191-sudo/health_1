@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head><title>Insurance Management System</title></head>
<body>
<h1>Insurance Management System</h1>
<p>ASP.NET MVC 5 / Web API 2 / .NET Framework 4.8</p>
<p>No ASP.NET Core / .NET Core.</p>
<h3>Business flows</h3>
<ul>
<li>Customer/member registration and profile management</li>
<li>Insurance product and plan setup</li>
<li>Quote creation and premium calculation</li>
<li>Policy application submission</li>
<li>Underwriting review and approval/rejection</li>
<li>Policy issuance and policy document tracking</li>
<li>Premium payment and payment history</li>
<li>Policy renewal and cancellation</li>
<li>Endorsement/change request processing</li>
<li>Claim registration and document capture</li>
<li>Claim validation, assessment and settlement</li>
<li>Fraud/risk review status tracking</li>
<li>Agent/customer service case management</li>
<li>Search, dashboards and operational reporting</li>
<li>Audit/history tracking</li>
</ul>
</body>
</html>
